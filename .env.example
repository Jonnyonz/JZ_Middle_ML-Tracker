# Configuracion de la instalacion de JZ Middle ML-Tracker. Copiar a .env (Docker) o lo arma
# install-native.sh en /etc/jzmiddle/jzmiddle.env. Lo que es del cliente (conexion con Tracker,
# aplicacion de Mercado Libre, cuentas) se carga despues desde la pagina, no aca.

# --- Base de datos (Docker: la del contenedor db; nativa: base y rol propios en el Postgres del servidor) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jzmiddle_db
POSTGRES_USER=jzmiddle
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
DB_POOL_MAX=5

# --- Configuracion inicial: token para crear el primer administrador (openssl rand -hex 24) ---
SETUP_TOKEN=cambiar-por-un-token-largo

# --- Direccion publica con HTTPS de este servicio (subdominio del cliente detras de Caddy) ---
# Mercado Libre vuelve a <PUBLIC_URL>/ml/callback y manda las notificaciones a <PUBLIC_URL>/ml/notifications.
PUBLIC_URL=https://ml.cliente.com

# --- Mercado Libre: pantalla de autorizacion del pais de las cuentas ---
# Argentina (por defecto): https://auth.mercadolibre.com.ar  -  Brasil: https://auth.mercadolivre.com.br
# ML_AUTH_URL=https://auth.mercadolibre.com.ar
# Cada cuantos segundos se revisan los permisos que estan por vencer (se renuevan antes de vencer).
# ML_RENOVAR_SEGUNDOS=600

# --- Avisos de Mercado Libre: aceptarlos solo desde las IPs que documenta ML (vacio = de cualquier IP) ---
# ML_NOTIFICACIONES_IPS=54.88.218.97,18.215.140.160,18.213.114.129,18.206.34.84

# --- Proxies de confianza para la IP real (X-Forwarded-For) ---
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# Cookies Secure (true en produccion con HTTPS; false SOLO para probar por HTTP en la maquina local)
COOKIES_SECURE=true

# --- Docker: donde escucha el servicio (Caddy le habla a esta direccion) ---
APP_BIND=127.0.0.1
APP_PORT=8040
